# =============================================================================
# OORCA — Environment Configuration & API Keys
# =============================================================================
# Copy this file to '.env' and populate your API credentials:
#   cp .env.example .env
#
# NOTE: The OORCA engine includes built-in fallback mathematical and
# physical simulation engines (calibrated OpenDrift hydrodynamic equations,
# realistic Fay spreading models, and synthetic oceanographic profiles),
# so the application will run and function fully even without external API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# STEP 1: Core Application & Server Runtime
# -----------------------------------------------------------------------------
# Node environment ('development' or 'production')
NODE_ENV=development

# Server port (Default: 3000)
PORT=3000

# Base URL for public hosting or local development
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# STEP 2: Google Gemini AI Intelligence
# -----------------------------------------------------------------------------
# Required for automated environmental impact narratives, risk assessments,
# and AI-generated contingency advisory reports.
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# STEP 3: Live Weather & Metocean Intelligence (OpenWeatherMap)
# -----------------------------------------------------------------------------
# Used by the LiveWeatherMonitor component and backend environment proxy
# for real-time wind speed, wind direction, barometric pressure, and temperature.
# Obtain key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=
WEATHER_API_KEY=
VITE_WEATHER_API_KEY=

# -----------------------------------------------------------------------------
# STEP 4: Global Fishing Watch (GFW) & Maritime AIS Intelligence
# -----------------------------------------------------------------------------
# Used for real-time vessel tracking, AIS position decoding, and fleet monitoring.
# Obtain token at: https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=
VITE_GFW_API_TOKEN=

# -----------------------------------------------------------------------------
# STEP 5: Oceanographic Current & Bathymetry APIs
# -----------------------------------------------------------------------------
# Used for deep-water bathymetric vectors, tidal currents, and thermohaline circulation.
# Supported providers: NOAA, Copernicus Marine (CMEMS), or Stormglass.
# NOAA API: https://www.ncdc.noaa.gov/cdo-web/token
# Copernicus Marine: https://marine.copernicus.eu/
OCEAN_DATA_API_KEY=
VITE_OCEAN_DATA_API_KEY=
NOAA_API_KEY=
COPERNICUS_API_KEY=

# -----------------------------------------------------------------------------
# STEP 6: Satellite Imagery & Remote Sensing
# -----------------------------------------------------------------------------
# Used by the satellite analysis module for Sentinel-1/2 SAR radar imagery
# and multi-spectral oil slick detection feeds.
# Copernicus Open Access / Sentinel Hub: https://dataspace.copernicus.eu/
VITE_SATELLITE_API_KEY=

# -----------------------------------------------------------------------------
# STEP 7: AIS Vessel Tracking Feeds (Commercial Alternative)
# -----------------------------------------------------------------------------
# Commercial AIS tracking providers (Spire Global, MarineTraffic, AISHub).
VITE_AIS_API_KEY=

# -----------------------------------------------------------------------------
# STEP 8: Geospatial Vector & Basemap Services
# -----------------------------------------------------------------------------
# Custom CARTO basemap or Mapbox tile access (Optional; default uses public CARTO GL tiles).
VITE_CARTO_API_KEY=
VITE_MAP_API_KEY=

# -----------------------------------------------------------------------------
# STEP 9: Database & Telemetry Storage (Optional)
# -----------------------------------------------------------------------------
# PostgreSQL or Cloud SQL connection string for persisting historical simulations.
DATABASE_URL=
